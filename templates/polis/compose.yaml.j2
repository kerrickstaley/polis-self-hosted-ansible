name: polis
x-runtime: &runtime
  restart: unless-stopped
  networks: [app]
  dns: [127.0.0.1]
  cap_drop: [NET_RAW]
  security_opt: [no-new-privileges:true]
x-source: &source ./compdemocracy-polis-f20c354
x-identity: &identity
  AUTH_ISSUER: https://{{ polis_domain }}/identity
  AUTH_AUDIENCE: polis
  AUTH_CLIENT_ID: polis
  AUTH_NAMESPACE: https://{{ polis_domain }}/
x-db: &db
  DATABASE_URL: postgresql://polis_app:${APP_PASSWORD:?}@postgres:5432/polis
  MATH_ENV: python

services:
  postgres:
    <<: *runtime
    build:
      context: ./compdemocracy-polis-f20c354/server
      dockerfile: Dockerfile-db
      additional_contexts:
        queue-rs: ./compdemocracy-polis-f20c354/queue-rs
    environment:
      POSTGRES_DB: polis
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      APP_PASSWORD: ${APP_PASSWORD:?}
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./app-role.sql:/docker-entrypoint-initdb.d/01-app-role.sql:ro
    healthcheck:
      test: [CMD, pg_isready, -h, 127.0.0.1, -U, postgres, -d, polis]
      interval: 5s
      timeout: 3s
      retries: 120

  server:
    <<: *runtime
    build:
      context: *source
      dockerfile: server/Dockerfile
      target: prod
    environment:
      <<: [*identity, *db]
      API_PROD_HOSTNAME: {{ polis_domain }}
      STATIC_FILES_HOST: files
      STATIC_FILES_PORT: "8080"
      JWKS_URI: http://gateway:8081/identity/keys
      POLIS_JWT_ISSUER: https://{{ polis_domain }}/
      JWT_PRIVATE_KEY_PATH: /keys/private.pem
      JWT_PUBLIC_KEY_PATH: /keys/public.pem
      LOGIN_CODE_PEPPER: ${LOGIN_CODE_PEPPER:?}
      ENCRYPTION_PASSWORD_00001: ${ENCRYPTION_PASSWORD:?}
      AWS_EC2_METADATA_DISABLED: "true"
      DELPHI_RESULT_BACKEND: postgres
      DELPHI_RESULT_ENV: local
      SHOULD_USE_TRANSLATION_API: "false"
      DD_TRACE_ENABLED: "false"
    volumes:
      - ./keys:/keys:ro
    depends_on:
      postgres: {condition: service_healthy}

  files:
    <<: *runtime
    build:
      context: *source
      dockerfile: file-server/Dockerfile
      args:
        <<: *identity
        EMBED_SERVICE_HOSTNAME: {{ polis_domain }}
        OIDC_CACHE_KEY_PREFIX: polis.google.user
        OIDC_CACHE_KEY_ID_TOKEN_SUFFIX: "@@user@@"
    environment:
      PORT: "8080"

  math:
    <<: *runtime
    build:
      context: ./compdemocracy-polis-f20c354/delphi
      dockerfile: ../../math.Dockerfile
    environment:
      <<: *db
      DATABASE_SSL_MODE: disable
      MATH_POLLER_INSTANCE_ID: polis
      MATH_WORKER_POOL_SIZE: "1"
      OPENBLAS_NUM_THREADS: "1"
      OMP_NUM_THREADS: "1"
    mem_limit: 1152m
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - |
          import os, socket, psycopg2
          with psycopg2.connect(os.environ["DATABASE_URL"]) as db, db.cursor() as cur:
              cur.execute(
                  "SELECT 1 FROM pg_locks JOIN pg_stat_activity USING (pid) "
                  "WHERE locktype = 'advisory' AND granted AND application_name = %s",
                  ("math-python:python@" + socket.gethostname(),),
              )
              raise SystemExit(0 if cur.fetchone() else 1)
      interval: 15s
      timeout: 5s
      retries: 5
    depends_on:
      postgres: {condition: service_healthy}

  participation:
    <<: *runtime
    build:
      context: *source
      dockerfile: client-participation-alpha/Dockerfile
      args:
        PUBLIC_SERVICE_URL: https://{{ polis_domain }}/api/v3
        INTERNAL_SERVICE_URL: http://gateway:8081/api/v3
        PUBLIC_AUTH_NAMESPACE: https://{{ polis_domain }}/
        OIDC_CACHE_KEY_PREFIX: polis.google.user
        OIDC_CACHE_KEY_ID_TOKEN_SUFFIX: "@@user@@"
    environment:
      INTERNAL_SERVICE_URL: http://gateway:8081/api/v3
      HOST: "0.0.0.0"
      PORT: "4321"

  identity:
    <<: *runtime
    build:
      context: ./proxy
      dockerfile_inline: |
        FROM ghcr.io/dexidp/dex:v2.46.1@sha256:65b72ca0f4b0bf6d4ada84ec21da8851782563404ac7b8f926923d27ceced9ab
        COPY dex.yaml /etc/dex/config.docker.yaml
    networks: [identity]
    volumes:
      - dexdata:/var/dex

  gateway:
    <<: *runtime
    build:
      context: ./proxy
      dockerfile_inline: |
        FROM nginx:stable-alpine@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
        COPY gateway.conf /etc/nginx/conf.d/default.conf
        COPY polis-voter.js /usr/share/nginx/html/polis-voter.js
    # A host power loss can leave an unbound socket in this directory.
    command: [sh, -ec, "rm -f /ingress/polis.sock && exec nginx -g 'daemon off;'"]
    networks: [app, identity]
    volumes:
      - ./ingress:/ingress
    depends_on: [server, files, identity, participation]

networks:
  app: &private
    internal: true
    driver_opts:
      com.docker.network.bridge.gateway_mode_ipv4: isolated
  identity: *private

volumes:
  pgdata:
  dexdata:
