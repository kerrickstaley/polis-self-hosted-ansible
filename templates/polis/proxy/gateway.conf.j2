resolver 127.0.0.11 valid=10s ipv6=off;
upstream polis_api {
    zone polis_api 64k;
    server server:5000 resolve;
}
upstream polis_identity {
    zone polis_identity 64k;
    server identity:5556 resolve;
}
upstream polis_participation {
    zone polis_participation 64k;
    server participation:4321 resolve;
}

# Only the host OAuth2 Proxy can reach this listener.
server {
    listen unix:/ingress/polis.sock;
    server_name {{ polis_domain }};
    client_max_body_size 50m;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
    add_header X-DNS-Prefetch-Control off always;
    add_header Referrer-Policy same-origin always;

    proxy_set_header Host {{ polis_domain }};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie "";
    proxy_set_header X-Forwarded-User "";
    proxy_set_header X-Forwarded-Email "";
    proxy_set_header X-Forwarded-Groups "";
    proxy_set_header X-Forwarded-Preferred-Username "";
    proxy_set_header X-Polis-Google-Sub $http_x_forwarded_user;
    proxy_set_header X-Polis-Google-Email $http_x_forwarded_email;

    location /identity/ {
        proxy_pass http://polis_identity;
        proxy_pass_request_headers off;
        proxy_set_header Host {{ polis_domain }};
        proxy_set_header X-Remote-User $http_x_forwarded_email;
        proxy_set_header X-Remote-User-Id $http_x_forwarded_user;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Authorization $http_authorization;
    }

    location /alpha/ { proxy_pass http://polis_participation/; }
    location /_astro/ { proxy_pass http://polis_participation; }
    location = /polis-voter.js { root /usr/share/nginx/html; }
    location / { proxy_pass http://polis_api; }
}

# The API can fetch signing keys here. Identity assertions require the socket.
server {
    listen 8081;
    location = /identity/keys { proxy_pass http://polis_identity; }
    location /api/v3/ {
        proxy_pass http://polis_api;
        proxy_set_header X-Polis-Google-Sub "";
        proxy_set_header X-Polis-Google-Email "";
        proxy_set_header Host {{ polis_domain }};
        proxy_set_header X-Forwarded-Proto https;
    }
    location / { return 404; }
}
