server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name {{ polis_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ polis_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ polis_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        include /etc/nginx/snippets/polis-https-location.conf;
    }
}
